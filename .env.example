# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=llmint
DB_USER=llmint
# Change to a strong password before deploying!
DB_PASS=llmint
DB_ROOT_PASS=changeme123

# ── Web server ────────────────────────────────────────────────────────────────
# Host port the application will be reachable on.
HTTP_PORT=8080
# Host port phpMyAdmin will be reachable on.
PMA_PORT=8081
# HTTP Basic Auth credentials required before reaching the phpMyAdmin login
# form (defense in depth on top of the DB login). Change these before
# deploying!
PMA_BASIC_AUTH_USER=admin
PMA_BASIC_AUTH_PASSWORD=changeme

# PHP / system timezone
TZ=Europe/Berlin

# ── Document converter (docconvert container) ─────────────────────────────────
# Base URL of the Python/FastAPI conversion service. Leave empty to disable the
# service; plain-text formats then still work through the PHP fallback, Office
# formats are rejected.
DOCCONVERT_URL=http://docconvert:8000
# Optional shared secret. When set, the web container sends it as X-Auth-Token
# and the converter rejects requests without it.
DOCCONVERT_TOKEN=
# Seconds the web container waits for a conversion.
DOCCONVERT_TIMEOUT=120
# Maximum upload size accepted by the converter, in bytes (20 MB).
DOCCONVERT_MAX_BYTES=20971520
# Target chunk size and overlap in characters.
DOCCONVERT_MAX_CHARS=1800
DOCCONVERT_OVERLAP=250
# Temporary result cache: lifetime in seconds (0 disables it) and entry count.
DOCCONVERT_CACHE_TTL=3600
DOCCONVERT_CACHE_MAX=500
