# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=llmint
DB_USER=llmint
# Change to a strong password before deploying!
DB_PASS=llmint
DB_ROOT_PASS=changeme123

# ── Web server ────────────────────────────────────────────────────────────────
# Host port the application will be reachable on.
HTTP_PORT=8080
# Host port phpMyAdmin will be reachable on.
PMA_PORT=8081
# HTTP Basic Auth credentials required before reaching the phpMyAdmin login
# form (defense in depth on top of the DB login). Change these before
# deploying!
PMA_BASIC_AUTH_USER=admin
PMA_BASIC_AUTH_PASSWORD=changeme

# PHP / system timezone
TZ=Europe/Berlin

# ── Reverse proxy (lanpa auth container) ──────────────────────────────────────
# Optional: publish LLMInt via lanpa under https://<lanpa-host>/ki/ (central
# certificate management, Windows SSO). See README "Betrieb hinter lanpa".
# Same Docker host: use docker-compose.lanpa.yml (sets both values below).
# Other host: TRUSTED_PROXIES=<IP of the lanpa host>.
# Bind the direct port to localhost so the proxy cannot be bypassed, e.g.
# HTTP_PORT=127.0.0.1:8080
# Comma-separated IPs, CIDR ranges or host names of trusted reverse proxies.
TRUSTED_PROXIES=
# Header with the Windows-SSO user set by the proxy (lanpa: X-Remote-User).
PROXY_SSO_HEADER=
# Shared Docker network of docker-compose.lanpa.yml.
#LLMINT_PROXY_NETWORK=llmint-proxy

# ── Document converter (docconvert container) ─────────────────────────────────
# Base URL of the Python/FastAPI conversion service. Leave empty to disable the
# service; plain-text formats then still work through the PHP fallback, Office
# formats are rejected.
DOCCONVERT_URL=http://docconvert:8000
# Optional shared secret. When set, the web container sends it as X-Auth-Token
# and the converter rejects requests without it.
DOCCONVERT_TOKEN=
# Seconds the web container waits for a conversion.
DOCCONVERT_TIMEOUT=120
# Maximum upload size accepted by the converter, in bytes (20 MB).
DOCCONVERT_MAX_BYTES=20971520
# Target chunk size and overlap in characters.
DOCCONVERT_MAX_CHARS=1800
DOCCONVERT_OVERLAP=250
# Temporary result cache: lifetime in seconds (0 disables it) and entry count.
DOCCONVERT_CACHE_TTL=3600
DOCCONVERT_CACHE_MAX=500

# ── Knowledge base / vector database (milvus container) ──────────────────────
# LLMInt no longer lets users upload globally shared documents. Shared knowledge
# comes from docvecwizard – either via its REST API (remote mode) or by
# importing a docvecwizard export archive into the local Milvus instance below
# (local mode). Mode and credentials are configured in the admin UI
# ("Wissensdatenbank"); the values here are only the defaults for local mode.
MILVUS_VERSION=v2.5.27
MILVUS_URL=http://milvus:19530
MILVUS_METRICS_URL=http://milvus:9091
# Memory cap for the Milvus container (adjust to the size of your exports).
MILVUS_MEM_LIMIT=2g

# ── Speech recognition (whisper.cpp container) ────────────────────────────────
# Dictation: the browser records audio, this service transcribes it and the
# dictation model below turns the transcript into clean text. Everything is
# configurable in the admin UI ("Spracherkennung / Diktat"); the values here are
# the container defaults.
WHISPER_URL=http://whisper:8080
# Optional shared secret. When set, the web container sends it as X-Auth-Token
# and whisper.cpp rejects requests without it (--api-key on the server side).
WHISPER_TOKEN=
# Seconds the web container waits for one transcription.
WHISPER_TIMEOUT=120
# ggml model name (tiny/base/small/medium/large-v3, plus .en and quantised
# variants). "small" is the recommended compromise for German dictation.
WHISPER_MODEL=small
# Spoken language passed to the recogniser ("auto" for auto-detection).
WHISPER_LANGUAGE=de
# CPU threads used for inference.
WHISPER_THREADS=4
# Image tag, e.g. main-cuda / main-vulkan / main-arm64 for GPU or ARM hosts.
WHISPER_IMAGE_TAG=main

# ── Dictation model (Qwen3.5-2B Q4 via llama.cpp container) ───────────────────
# Dedicated llama.cpp server for the dictation-command processing step. Leave
# QWEN_URL empty to route that step through the regular endpoint pool instead
# (only useful when Qwen3.5-2B is already served by one of your endpoints).
QWEN_URL=http://qwen:8080
QWEN_TOKEN=
# Seconds the web container waits for one dictation-processing call.
QWEN_TIMEOUT=60
# GGUF source. The default repo ships Q4_K_M, the quantisation used by default.
QWEN_GGUF_REPO=unsloth/Qwen3.5-2B-GGUF
QWEN_GGUF_FILE=Qwen3.5-2B-Q4_K_M.gguf
# Model id reported by the server; must match the model configured for the
# dictation step in the admin UI ("Qwen3.5-2B Q4" by default).
QWEN_MODEL_ALIAS=Qwen3.5-2B Q4
# Context window in tokens. Dictation fragments are short, 4096 is plenty.
QWEN_CTX_SIZE=4096
QWEN_THREADS=4
# Image tag: server (CPU) is the portable default; server-cuda, server-vulkan,
# server-rocm or server-intel enable GPU acceleration.
QWEN_IMAGE_TAG=server
